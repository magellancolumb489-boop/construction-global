# Supabase (required for auth and data)
# Get these from: Supabase Dashboard > Project Settings > API
# If keys were ever exposed (chat, screenshots), rotate them in the dashboard before shipping.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Alternative: Supabase dashboard shows "anon key" - use either variable name
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Supabase service role (CLI / scripts only — not used by this app's runtime)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: gate GET /api/supabase-health in production
# SUPABASE_HEALTH_SECRET=

# Payments. Demo vs live is set in the DB (Admin > Setari platforma > Mod plati),
# not by an env flag. These only configure the live provider (server-only).
# PAYMENTS_PROVIDER=netopia            # demo | stripe | netopia | euplatesc | revolut
# APP_BASE_URL=https://your-domain.ro  # success / cancel / webhook URLs
# Shared secret for the webhook -> DB call. Set the SAME value once in the SQL editor:
#   select private.set_secret('payments_webhook', '<value>');
# PAYMENTS_WEBHOOK_DB_SECRET=
# Provider credentials (read by lib/payments/providers/<id>.ts once implemented), e.g.:
# NETOPIA_API_KEY= / NETOPIA_POS_SIGNATURE= / NETOPIA_PUBLIC_KEY=
# STRIPE_SECRET_KEY= / STRIPE_WEBHOOK_SECRET=

# Optional: shared rate limits across serverless instances (Upstash Redis REST).
# Without these, /api/geocode and /api/route limit per instance only.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Resend (server-only — never use NEXT_PUBLIC_ for the API key)
# Replace re_xxxxxxxxx with your real API key from https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxx
# Verified sender, e.g. "ConstructionHub Romania <onboarding@resend.dev>" for testing
# RESEND_FROM=
