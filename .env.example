# Supabase (required for auth and data)
# Get these from: Supabase Dashboard > Project Settings > API
# If keys were ever exposed (chat, screenshots), rotate them in the dashboard before shipping.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Alternative: Supabase dashboard shows "anon key" - use either variable name
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Supabase service role (CLI / scripts only — not used by this app's runtime)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: gate GET /api/supabase-health in production
# SUPABASE_HEALTH_SECRET=
