# Supabase (required for auth and data)
# Get these from: Supabase Dashboard > Project Settings > API
# If keys were ever exposed (chat, screenshots), rotate them in the dashboard before shipping.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Alternative: Supabase dashboard shows "anon key" - use either variable name
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Supabase service role (CLI / scripts only — not used by this app's runtime)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: gate GET /api/supabase-health in production
# SUPABASE_HEALTH_SECRET=

# Checkout: demo flow (no Stripe) unless you set stripe explicitly.
# NEXT_PUBLIC_PAYMENTS_MODE=demo
# Later: NEXT_PUBLIC_PAYMENTS_MODE=stripe

# Resend (server-only — never use NEXT_PUBLIC_ for the API key)
# Replace re_xxxxxxxxx with your real API key from https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxx
# Verified sender, e.g. "ConstructionHub Romania <onboarding@resend.dev>" for testing
# RESEND_FROM=
